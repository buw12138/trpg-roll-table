  "inventory": [
    "一支火把、50 英尺长的绳索、基本补给品。",
    "- 一瓶小型治疗药剂（恢复 1d4 生命点）或一瓶小型精力药剂（清除 1d4 压力点）",
    "- 一枚低语宝珠或一件传家宝",
    "- 一台巴掌大的黄铜匣子：法术预先编译在符文片上，插卡即可施放（职业物品）",
    "- 一本你正在尝试翻译的书，或一只无害的小型元素宠物"
  ],
  "characterBackground": "人类，博识之民，编译所的前维护者。他不相信“天赋”，只相信可复现的流程：法术在他手里被拆成指令、编译成符文片，插进那台黄铜匣子里就能生效——快、准、可重复。代价是他只会打自己写过的仗。东南角结界事故之后，他带着匣子和半卷《第一编译》离开博识之民的地界，一边找另外半卷，一边在真实的战场上给没写过的情况做现场编译。",
  "characterAppearance": "",
  "characterMotivation": "三十岁上下，短发，眼底有长期熬夜的青色。外套内衬缝满窄口袋，插着一排薄薄的符文片，边缘被磨得发亮。左手食指到虎口有一道旧灼痕。随身机是一台巴掌大的黄铜匣子，合上时像首饰盒，打开时里面的水晶会嗡嗡发热；施法时他抽出一张符文片插进去，咔哒一声，空中浮出一行行发光的字，字读完，目标就烧起来了。",
  "cards": [
    {
      "standarized": true,
      "id": "Wizard",
      "name": "法师",
      "class": "法师",
      "type": "profession",
      "description": "魔法伎俩：你可以随意施展无害、微妙的魔法效果。例如，你可以改变物体的颜色、制造气味、点燃蜡烛、让小物体漂浮、照亮房间或修复小物件。\n\n奇异规律：选择一个介于 1 到 12 之间的数字。当你在一次二元骰掷骰中掷出该数字时，**获得 1 希望点**或**清除 1 压力点**。你可以在进行一次长休时改变这个数字。",
      "cardSelectDisplay": {
        "item1": "典籍",
        "item2": "辉耀"
      },
      "professionSpecial": {
        "起始生命": 5,
        "起始闪避": 11,
        "起始物品": "",
        "希望特性": "死期未至：**花费 3 希望点**，迫使远距离范围内的某个敌人重掷一次攻击掷骰或伤害掷骰。"
      },
      "headerDisplay": "法师",
      "ruleset": "daggerheart",
      "batchId": "SYSTEM_BUILTIN_CARDS",
      "source": "builtin"
    },
